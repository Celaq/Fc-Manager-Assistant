# Discord Developer Portal → General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Discord와 Windows PC에서 모두 접근 가능한 HTTPS 주소 (끝에 / 없이 입력)
PUBLIC_ORIGIN=https://fc.example.com

# 특정 Discord 서버에만 명령을 등록하려면 해당 서버 ID 입력
DISCORD_GUILD_ID=

# 운영자 오류 보고 채널의 Discord 웹훅 URL (맥 서버에만 입력)
OPERATOR_DIAGNOSTIC_WEBHOOK=
